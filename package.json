  "description": "Enterprise Playwright checkout automation framework",
  "license": "ISC",
  "author": "Varsha Yadav",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:checkout": "playwright test tests/checkout/booking.spec.ts",
