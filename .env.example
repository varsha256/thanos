# Copy to `.env` and adjust. `.env` is git-ignored and loaded automatically via dotenv.

# Logical environment: dev | qa | prod
TEST_ENV=qa

# Base URLs (override the per-environment defaults in config/environment.ts)
UI_BASE_URL=https://practicetestautomation.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Secrets / credentials used by the auth setup project
APP_USERNAME=student
APP_PASSWORD=Password123

# Optional bearer token for authenticated API calls
API_TOKEN=
